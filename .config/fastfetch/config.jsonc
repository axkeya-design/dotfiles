{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "$HOME/.dotfiles/assets/logo_fastfetch.png",
        "width": 55,
        "height": 8,
        "padding": {
            "top": 5,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "showErrors": false,
        "separator": " ⚡ ",
        "key": {
            "width": 12
        },
        "color": {
            "1": "blue"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[34m[ \u001b[1;36m{1}\u001b[0m\u001b[38;2;0;168;255m@\u001b[0m\u001b[1;36m{2} \u001b[0m\u001b[34m]"
        },
        {
            "type": "custom",
            "format": "┌─ System Data ───────────────────────────────┐",
            "outputColor": "blue"
        },
        {
            "type": "os",
            "key": "  󰍹 SYS",
            "keyColor": "\u001b[38;2;0;240;255m",
            "format": "{3} {12}"
        },
        {
            "type": "host",
            "key": "  󰌢 HST",
            "keyColor": "\u001b[38;2;0;240;255m"
        },
        {
            "type": "kernel",
            "key": "   KRN",
            "keyColor": "\u001b[38;2;0;240;255m"
        },
        {
            "type": "uptime",
            "key": "  󱎫 UPT",
            "keyColor": "\u001b[38;2;0;240;255m"
        },
        {
            "type": "wm",
            "key": "  󰖲 ENV",
            "keyColor": "\u001b[38;2;0;168;255m"
        },
        {
            "type": "sound",
            "key": "  󰓃 AUD",
            "keyColor": "\u001b[38;2;0;168;255m",
            "format": "{platform-api} ({volume-percentage})"
        },
        {
            "type": "terminal",
            "key": "  󰆍 TRM",
            "keyColor": "\u001b[38;2;0;168;255m"
        },
        {
            "type": "shell",
            "key": "  󰞷 SHL",
            "keyColor": "\u001b[38;2;0;168;255m"
        },
        {
            "type": "custom",
            "format": "├─ Hardware ──────────────────────────────────┤",
            "outputColor": "blue"
        },
        {
            "type": "cpu",
            "key": "  󰍛 CPU",
            "keyColor": "\u001b[38;2;0;85;255m",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "  󰢮 GPU",
            "keyColor": "\u001b[38;2;0;85;255m",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "  󰍛 RAM",
            "keyColor": "\u001b[38;2;0;85;255m"
        },
        {
            "type": "disk",
            "key": "  󰋊 DRV",
            "keyColor": "\u001b[38;2;0;85;255m",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "custom",
            "format": "└─────────────────────────────────────────────┘",
            "outputColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}

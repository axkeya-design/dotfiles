* {
    bg:               #0f111add;  
    bg-light:         #151825ff;  
    border-color:     #3d59a1ff;  
    accent:           #7aa2f7ff;  
    accent-glow:      #2ac3deff;  
    fg:               #c0caf5ff;  
    fg-dim:           #565f89ff;  
    selected-bg:      #24283bff;  
    urgent:           #f7768eff;  

    font: "JetBrains Mono Nerd Font 10";
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    
    /* Расположение справа */
    location: east;
    anchor: east;
    
    /* Отступы от краев экрана */
    x-offset: -16px;   /* Отступ справа */
    y-offset: 15px;    /* Отступ сверху от бара */
    
    width: 320px;
    
    /* Скругление со всех сторон и обводка */
    border: 2px;
    border-color: @border-color;
    border-radius: 12px;
    
    padding: 14px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-light;
    expand: false;
    border: 1px;
    border-radius: 8px;
    border-color: @border-color;
    margin: 0px 0px 10px 0px;
    padding: 6px 10px;
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0px 6px 0px 0px;
    font: "JetBrains Mono Nerd Font Bold 10";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 15;        /* Увеличена высота (больше пунктов) */
    spacing: 4px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    padding: 8px 10px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
}

element-icon {
    size: 20px;
    padding: 0px 10px 0px 0px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}

element selected {
    background-color: @selected-bg;
    text-color: @accent-glow;
    border: 0px 0px 0px 3px; 
    border-color: @accent-glow;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element selected.active {
    background-color: @border-color;
    text-color: @fg;
}

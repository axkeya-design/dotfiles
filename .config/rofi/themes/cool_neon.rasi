/**
 * Modern Custom Cyber-Dark Theme for Rofi
 * Based on Qball concept, but modernized and polished.
 */

* {
    bg:           #0f111add;  
    bg-light:     #151825ff;  
    border-color: #7aa2f7ff;  
    accent:       #00f5d4ff;  
    fg:           #c0caf5ff;  
    fg-dim:       #565f89ff;  
    selected-bg:  #2f354fff;  
    urgent:       #f7768eff;  

    font: "JetBrains Mono Nerd Font 10";
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2px;
    border-color: @border-color;
    border-radius: 12px;
    width: 600px;
    padding: 15px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-light;
    expand: false;
    border: 1px;
    border-radius: 8px;
    border-color: @border-color;
    margin: 0px 0px 12px 0px;
    padding: 8px 12px;
}

prompt {
    background-color: @border-color;
    text-color: @bg;
    padding: 4px 10px;
    border-radius: 6px;
    font: "JetBrains Mono Nerd Font Bold 10";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    padding: 4px;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    padding: 0px 12px 0px 0px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}

element selected {
    background-color: @selected-bg;
    text-color: @accent;
    border: 0px 0px 0px 4px; 
    border-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element selected.active {
    background-color: @border-color;
    text-color: @bg;
}

element alternate.normal {
    background-color: transparent;
}

